FORTEVISION_API_KEY=replace-with-a-long-random-local-secret
FORTEVISION_MODEL=models/action_states_v8.joblib
FORTEVISION_WEIGHTS=models/resnet18-f37072fd.pth
FORTEVISION_DEVICE=cpu
FORTEVISION_MAX_UPLOAD_MB=256
FORTEVISION_QUEUE_SIZE=3
FORTEVISION_MAX_JOBS=20
FORTEVISION_JOB_TTL_SECONDS=3600
FORTEVISION_TIMEOUT_SECONDS=295
FORTEVISION_API_URL=http://127.0.0.1:8000
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
# Optional: keep runtime state outside synced folders. Default is system TEMP.
# FORTEVISION_UPLOAD_DIR=C:/fortevision-runtime/uploads
# FORTEVISION_JOB_DB=C:/fortevision-runtime/state/jobs.sqlite3
# Only for public HTTPS deployment:
# FORTEVISION_DOMAIN=your-real-domain.example
# ACME_EMAIL=your-contact@example.com

# Default: local CPU review model. VLM is optional and experimental.
FORTEVISION_BACKEND=classifier
FORTEVISION_START_VLM=0
# Override only when mounting another trusted model into Docker.
FORTEVISION_CONTAINER_MODEL=/app/models/action_states_v8.joblib
